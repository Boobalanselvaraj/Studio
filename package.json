{
  "name": "photo-studio-saas-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Photo Studio SaaS Platform with Event Management, Custom Folders, and Self-Hosted Media Engine",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "dev:api": "npm --workspace=apps/backend run dev",
    "dev:web": "npm --workspace=apps/frontend run dev",
    "build:backend": "npm --workspace=apps/backend run build",
    "build:frontend": "npm --workspace=apps/frontend run build",
    "build:api": "npm --workspace=apps/backend run build",
    "build:web": "npm --workspace=apps/frontend run build",
    "test:backend": "npm --workspace=apps/backend test",
    "db:generate": "npm --workspace=apps/backend run prisma:generate",
    "db:push": "npm --workspace=apps/backend run prisma:push",
    "db:seed": "npm --workspace=apps/backend run prisma:seed",
    "db:studio": "npm --workspace=apps/backend run prisma:studio",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "apps:up": "docker compose -f apps/docker-compose.yml up -d",
    "apps:down": "docker compose -f apps/docker-compose.yml down",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f"
  },
  "keywords": [
    "photo-studio",
    "saas",
    "photography",
    "multi-tenant",
    "event-management",
    "sftpgo"
  ],
  "author": "",
  "license": "UNLICENSED"
}
