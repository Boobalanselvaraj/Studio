{
  "name": "photo-studio-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "prisma generate --schema=prisma/schema.prisma && nodemon src/server.js",
    "test": "jest",
    "lint": "eslint src/",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "build": "prisma generate --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@prisma/client": "^6.4.1",
    "amqplib": "^0.10.4",
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "basic-ftp": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "chokidar": "^5.0.0",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.5",
    "sharp": "^0.35.4",
    "ssh2-sftp-client": "^12.1.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0"
  }
}
