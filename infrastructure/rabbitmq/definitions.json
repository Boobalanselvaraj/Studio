      "vhost": "/",
      "destination": "event-automation",
      "destination_type": "queue",
      "routing_key": "event.automation",
      "arguments": {}
    },
    {
      "source": "studio.direct",
      "vhost": "/",
      "destination": "billing-metering",
      "destination_type": "queue",
      "routing_key": "billing.metering",
      "arguments": {}
    }
  ]
