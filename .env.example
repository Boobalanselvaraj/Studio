# ==============================================================================
# Photo Studio SaaS Platform — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# Security & Secrets
SESSION_SECRET=super_secret_session_key_replace_in_production
JWT_SECRET=super_secret_jwt_key_replace_in_production
CREDENTIAL_ENCRYPTION_KEY=01234567890123456789012345678901

# PostgreSQL Database (External / Host PostgreSQL)
# - For Local Node.js: postgresql://<user>:<password>@localhost:5432/<dbname>
# - For Docker Apps to Host Postgres: postgresql://<user>:<password>@host.docker.internal:5432/<dbname>
# - For External Cloud Postgres: postgresql://<user>:<password>@<remote-host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://rtsdevpg:rtsdevpg123@100.86.37.81:5432/photo_studio_db

# Redis (Cache & Session Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Async Jobs & Events)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# SFTPGo Gateway
SFTPGO_HOST=localhost
SFTPGO_PORT=2022
SFTPGO_ADMIN_PORT=8080
SFTPGO_API_URL=http://localhost:8080/api/v2
SFTPGO_API_KEY=sftpgo_admin_api_key_replace_me
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=password123

# Storage Root Directory (For Local Provider)
STORAGE_ROOT_PATH=./storage

# Frontend Public Variables (Vite)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="StudioFlow SaaS"
