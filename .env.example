# ==============================================================================
# Photo Studio SaaS Platform — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# Security & Secrets
SESSION_SECRET=super_secret_session_key_replace_in_production
JWT_SECRET=super_secret_jwt_key_replace_in_production
CREDENTIAL_ENCRYPTION_KEY=32_byte_hex_encryption_key_change_me_0123456789abcdef

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photo_studio_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/photo_studio_db

# Redis (Cache & Session Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Async Jobs & Events)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# SFTPGo Gateway
SFTPGO_HOST=localhost
SFTPGO_PORT=2022
SFTPGO_ADMIN_PORT=8080
SFTPGO_API_URL=http://localhost:8080/api/v2
SFTPGO_API_KEY=sftpgo_admin_api_key_replace_me

# Immich Media Engine (Internal Only)
IMMICH_HOST=localhost
IMMICH_PORT=2283
IMMICH_API_URL=http://localhost:2283/api
IMMICH_API_KEY=immich_internal_api_key_replace_me

# Storage Root Directory (For Local Provider)
STORAGE_ROOT_PATH=/var/data/studio-storage

# Frontend Public Variables (Vite)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="StudioFlow SaaS"
